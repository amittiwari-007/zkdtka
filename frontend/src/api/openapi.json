  "info": {
    "description": "UK national wind generation forecasts as available at day-ahead purchase decision time, and their measured accuracy (Elexon BMRS FUELHH + WINDFOR).",
    "title": "Wind Forecast Decision Support API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/accuracy": {
      "get": {
        "description": "Accuracy of the forecasts available at decision time over a range of delivery days.",
        "operationId": "accuracy_api_accuracy_get",
        "parameters": [
          {
            "description": "First delivery day",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "First delivery day",
              "title": "From"
            }
          },
          {
            "description": "Last delivery day",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last delivery day",
              "title": "To"
            }
          },
          {
            "description": "UK local time on the day before delivery when the purchase is decided (HH:MM). Defaults to the EPEX gate closure, 09:20.",
            "in": "query",
            "name": "decision_time",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "UK local time on the day before delivery when the purchase is decided (HH:MM). Defaults to the EPEX gate closure, 09:20.",
              "examples": [
                "09:20"
              ],
              "title": "Decision Time"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccuracyReport"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Accuracy"
      }
    },
    "/api/day": {
      "get": {
        "description": "What the buyer knew at decision time for one delivery day, and what actually happened.",
        "operationId": "day_api_day_get",
        "parameters": [
          {
            "description": "UK delivery day (the day after the decision)",
            "in": "query",
            "name": "delivery_date",
            "required": true,
            "schema": {
              "description": "UK delivery day (the day after the decision)",
              "format": "date",
              "title": "Delivery Date",
              "type": "string"
            }
          },
          {
            "description": "UK local time on the day before delivery when the purchase is decided (HH:MM). Defaults to the EPEX gate closure, 09:20.",
            "in": "query",
            "name": "decision_time",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "UK local time on the day before delivery when the purchase is decided (HH:MM). Defaults to the EPEX gate closure, 09:20.",
              "examples": [
                "09:20"
              ],
              "title": "Decision Time"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DayView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Day"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/meta": {
      "get": {
        "description": "Date ranges in scope, decision-time presets and data provenance/quality.",
        "operationId": "meta_api_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meta"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Meta"
      }
    }
  }
